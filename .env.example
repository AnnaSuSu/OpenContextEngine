GPT_BASE_URL=https://provider.example.com/v1
GPT_API_KEY=
GPT_MODEL=gpt-6.1-sol
GPT_REASONING_EFFORT=medium
GPT_TIMEOUT_MS=300000
GPT_USER_AGENT=claude-cli/2.1.286 (external, cli)

EMBEDDING_BASE_URL=https://embedding.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B

RERANK_BASE_URL=https://rerank.example.com/v1
RERANK_API_KEY=
RERANK_MODEL=Qwen3-Reranker-4B

# Retrieval client: use the authenticated SSH forward to the remote worker.
OCE_BASE_URL=http://127.0.0.1:45005
# Optional dedicated key. Empty uses this project's existing RERANK_API_KEY.
OCE_API_KEY=

# Optional live workspace / MCP settings. State is outside the repository.
# OCE_PYTHON=/absolute/path/to/OpenContextEngine/.venv/bin/python
# OCE_GO_BINARY=/absolute/path/to/go
OCE_POLL_SECONDS=1
OCE_DEBOUNCE_SECONDS=0.3
OCE_EMBEDDING_DIMENSIONS=1024
# Increase when provider weights change under the same model name.
OCE_EMBEDDING_REVISION=1
# OCE_LANGUAGE_OPTIONS={"go":{"mode":"types"}}

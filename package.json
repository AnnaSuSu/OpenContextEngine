{
  "name": "open-context-engine",
  "version": "0.1.3",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepare-django": "node scripts/prepare-django.mjs",
    "ace-django": "node scripts/ace-django.mjs",
    "score-django": "node scripts/score-django.mjs",
    "baseline": "node scripts/run-baseline.mjs",
    "search": "node scripts/search-opencontextengine.mjs",
    "serve-retrieval": "node scripts/serve-opencontextengine.mjs",
    "benchmark-service": "node scripts/benchmark-service.mjs",
    "mcp": "node scripts/mcp-opencontextengine.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "description": "Live code context for AI coding agents, with automatic workspaces and MCP.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnnaSuSu/OpenContextEngine.git"
  },
  "homepage": "https://github.com/AnnaSuSu/OpenContextEngine#readme",
  "bin": {
    "open-context-engine": "bin/opencontextengine.mjs",
    "opencontextengine": "bin/opencontextengine.mjs"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "README.zh-CN.md",
    "bin/",
    "src/config.mjs",
    "src/environment.mjs",
    "src/client.mjs",
    "src/service.mjs",
    "src/shared-service.mjs",
    "src/workspaces.mjs",
    "src/mcp.mjs",
    "src/runtime.mjs",
    "src/setup.mjs",
    "src/eval/remote-models.mjs",
    "src/retrieval/**/*.py",
    "src/retrieval/**/*.mjs",
    "src/retrieval/**/*.go",
    "scripts/mcp-opencontextengine.mjs",
    "scripts/retrieval-server.py",
    "requirements.txt",
    "docs/QUICKSTART.md",
    "assets/brand/*.svg",
    "docs/RERANKER_API.md"
  ],
  "devDependencies": {
    "@augmentcode/auggie-sdk": "0.2.0",
    "@openai/codex-sdk": "0.160.0",
    "js-tiktoken": "1.0.21"
  },
  "license": "MIT",
  "author": "AnnaSuSu",
  "keywords": [
    "mcp",
    "code-search",
    "code-context",
    "codex",
    "claude-code",
    "retrieval"
  ],
  "bugs": {
    "url": "https://github.com/AnnaSuSu/OpenContextEngine/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
